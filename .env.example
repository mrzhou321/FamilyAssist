# Copy to .env before using FamilyAssister with real family data.
# Docker Compose reads this file automatically after it is copied to .env.

POSTGRES_PASSWORD=change-this-postgres-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_TOKEN_SECRET=change-this-long-random-token-secret

GENERATION_MODEL=qwen2.5:3b
EMBEDDING_MODEL=qllama/bge-small-zh-v1.5
